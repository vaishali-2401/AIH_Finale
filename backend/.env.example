# Connecting the Dots — backend configuration
#
# Copy to backend/.env and fill in what you need. Every value is optional:
# without GEMINI_API_KEY the app still uploads, displays and keyword-searches
# PDFs; AI connections, insights and Gemini voices switch on once a key is set.
# NEVER commit a real key — .env files are git-ignored.

# --- Gemini ------------------------------------------------------------------
GEMINI_API_KEY=
# Text model and fallbacks. Google retires models for new keys and they get
# overloaded at times; the app moves to the next model automatically. Only
# set these to override the built-in defaults shown here.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash
# AI_TIMEOUT_SECONDS=25
# EMBEDDING_MODEL=gemini-embedding-001

# --- Podcast text-to-speech ----------------------------------------------------
# Uses GEMINI_API_KEY unless TTS_API_KEY is set. If neither key is available,
# TTS_ENABLED=false, or the TTS call fails, the frontend falls back to the
# browser's built-in speech synthesis.
TTS_ENABLED=true
TTS_API_KEY=
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_FALLBACK_MODELS=gemini-3.1-flash-tts-preview,gemini-3.8-flash-lite-tts

# --- Server ------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Where the SQLite database, uploaded PDFs and generated audio are stored.
DATA_DIR=./data
# Comma-separated origins allowed to call the API (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
# Optional: directory of the exported frontend (frontend_app/out) to serve at "/".
FRONTEND_DIST=
